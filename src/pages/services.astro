---
import Base from '../layouts/Base.astro';
import { groups, icons } from '../lib/services';

const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[name]}</svg>`;
const bands = ['lime', 'paper', 'lilac', 'paper', 'pink', 'ink'];
---
<Base title="Services" description="Websites, Google Business Profile and local SEO, reviews, social media, design, video, email and monthly reports for small local businesses.">
  <section class="page-top">
    <div class="wrap">
      <span class="label reveal">Services</span>
      <h1 class="display misprint reveal" data-delay="1">Everything<br />to get found.</h1>
      <p class="sub reveal" data-delay="2">Pick one thing, or let me handle all of it.</p>
    </div>
  </section>

  <nav class="jump" aria-label="Service areas">
    <div class="wrap jump-inner">
      {groups.map((g, i) => (
        <a href={`#${g.id}`} data-jump={g.id} class={i === 0 ? 'active' : undefined}><span set:html={svg(g.icon)} />{g.short}</a>
      ))}
    </div>
  </nav>

  {groups.map((g, gi) => (
    <section class={`group band-${bands[gi]} ${bands[gi] === 'ink' ? 'on-ink' : ''}`} id={g.id}>
      <div class="wrap group-grid">
        <div class="group-head reveal">
          <span class="group-num">0{gi + 1}</span>
          <h2 class="display">{g.title}<br />{g.thin}</h2>
          <p>{g.line}</p>
        </div>
        <div class="items">
          {g.items.map((item, i) => (
            <div class={`item card hoverable reveal ${i % 2 ? 'tl' : 'tr'}`} data-delay={String(i % 3)}>
              <div class="ico" set:html={svg(item.icon)} />
              <div>
                <h3>{item.title}</h3>
                <p class="muted">{item.line}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap faq-grid">
      <h2 class="display misprint reveal">Good to<br />know.</h2>
      <div class="faq reveal" data-delay="1">
        <details>
          <summary>Do I have to sign up for everything?</summary>
          <p>No. Start with what you need most. Most businesses start with a website and their Google listing, then add more later.</p>
        </details>
        <details>
          <summary>How soon will I see results?</summary>
          <p>Usually around 90 days, and six months for real momentum. Fixing an unclaimed Google listing can be quicker.</p>
        </details>
        <details>
          <summary>Who owns my website?</summary>
          <p>You do. Your domain is in your name from day one. If you ever leave, you keep it, plus a working copy of your site.</p>
        </details>
        <details>
          <summary>Can I make changes myself?</summary>
          <p>Yes, anytime. And for anything bigger, I'll do it for you.</p>
        </details>
        <details>
          <summary>Can you guarantee I'll be #1 on Google?</summary>
          <p>No, and nobody honestly can. I guarantee the work, and you'll see the results in your report every month.</p>
        </details>
      </div>
    </div>
  </section>

  <style>
    .page-top { padding: 72px 0 56px; }
    .sub { font-size: 1.25rem; font-weight: 500; margin-top: 22px; }

    .jump { position: sticky; top: 77px; z-index: 40; background: var(--paper); border-top: var(--line); border-bottom: var(--line); }
    .jump-inner { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-top: 10px; padding-bottom: 10px; }
    .jump-inner::-webkit-scrollbar { display: none; }
    .jump a {
      flex: none; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
      padding: 8px 15px; border: 2.5px solid var(--ink); border-radius: 999px; background: var(--white);
      font-weight: 700; font-size: 0.92rem; text-decoration: none;
      transition: background 0.2s, transform 0.2s var(--ease);
    }
    .jump a :global(svg) { width: 17px; height: 17px; }
    .jump a:hover { transform: rotate(-3deg); }
    .jump a.active { background: var(--lime); box-shadow: 3px 3px 0 var(--ink); }

    .group { padding: 96px 0; scroll-margin-top: 140px; border-bottom: var(--line); }
    .band-lime { background: var(--lime); }
    .band-lilac { background: var(--lilac); }
    .band-pink { background: var(--pink); }
    .band-paper { background: var(--paper); }
    .group-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 56px; align-items: start; }
    .group-head { position: sticky; top: 170px; }
    .group-num {
      display: inline-grid; place-items: center; width: 58px; height: 58px; border-radius: 50%;
      border: var(--line); background: var(--white); color: var(--ink); font: 400 1.1rem var(--display);
      box-shadow: var(--pop-sm); margin-bottom: 24px; transform: rotate(-8deg);
    }
    .group-head h2 { font-size: clamp(1.9rem, 4.4vw, 3.2rem); margin-bottom: 18px; }
    .group-head p { font-size: 1.2rem; font-weight: 500; }
    .band-paper .group-head h2 { text-shadow: -0.05em -0.04em 0 var(--pink), 0.05em 0.04em 0 var(--lime); }
    .on-ink .group-head h2 { color: var(--paper); text-shadow: -0.05em -0.04em 0 var(--pink), 0.05em 0.04em 0 var(--lime); }
    .on-ink .group-num { border-color: var(--paper); box-shadow: 4px 4px 0 var(--pink); }

    .items { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .item { display: flex; flex-direction: column; gap: 20px; padding: 24px; }
    .item.tl.in { transform: rotate(-1deg); } .item.tr.in { transform: rotate(1deg); }
    .item.in:hover { transform: translate(-3px, -3px) rotate(0); }
    .item h3 { margin-bottom: 4px; }
    .on-ink .item { border-color: var(--paper); box-shadow: 6px 6px 0 var(--pink); }

    .faq-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 48px; align-items: start; }

    @media (max-width: 900px) {
      .page-top { padding: 48px 0 40px; }
      .group { padding: 64px 0; }
      .group-grid, .faq-grid { grid-template-columns: 1fr; gap: 32px; }
      .group-head { position: static; }
    }
    @media (max-width: 800px) { .jump { top: 77px; } }
    @media (max-width: 560px) {
      .items { grid-template-columns: 1fr; }
      .item { flex-direction: row; align-items: flex-start; gap: 16px; padding: 20px; }
      .item .ico { flex: none; }
    }
  </style>

  <script>
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.jump a'));
    const sections = links.map((a) => document.getElementById(a.dataset.jump!)).filter(Boolean) as HTMLElement[];
    const setActive = (id: string) => {
      links.forEach((a) => {
        const on = a.dataset.jump === id;
        if (on && !a.classList.contains('active')) a.parentElement?.scrollTo({ left: a.offsetLeft - 20, behavior: 'smooth' });
        a.classList.toggle('active', on);
      });
    };
    const onScroll = () => {
      const mark = window.innerHeight * 0.35;
      let current = sections[0]?.id;
      for (const s of sections) if (s.getBoundingClientRect().top <= mark) current = s.id;
      if (current) setActive(current);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Base>
