---
import { url } from '../lib/base';
import { SITE_NAME } from '../site-config';
import { groups } from '../lib/services';
import '../styles/global.css';

export interface Props {
  title: string;
  siteName?: string;
  description?: string;
  footerCta?: boolean;
}

const { title, siteName = SITE_NAME, description, footerCta = true } = Astro.props;
const fullTitle = title === 'Home' ? `${siteName} · Get found online` : `${title} · ${siteName}`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path.replace(/\/$/, '') === href;
const tickerItems = groups.flatMap((g) => g.items.map((i) => i.title));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&family=Rubik+Mono+One&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={url('/')} class="logo" aria-label={`${siteName} home`}>
          <img src={url('/brand/logo.png')} alt={siteName} width="150" height="50" />
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav">
          {nav.map((item) => (
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={url('/contact')} class="btn btn-lime">Let's talk</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => tickerItems.map((t) => <span>{t}</span>))}
      </div>
    </div>
    <footer class="site-footer on-ink">
      <div class="wrap">
        {footerCta && (
          <div class="footer-cta">
            <h2 class="display misprint">Ready to<br />get found?</h2>
            <a class="btn btn-lime" href={url('/contact')}>Let's talk <span class="arrow">→</span></a>
          </div>
        )}
        <div class="footer-row">
          <img src={url('/brand/logo-dark.png')} alt={siteName} width="130" height="43" />
          <nav>
            {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
            <a href={url('/contact')}>Contact</a>
            <a href="mailto:ashley@weaverdigital.io">ashley@weaverdigital.io</a>
          </nav>
          <span>&copy; {new Date().getFullYear()} {siteName}</span>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
